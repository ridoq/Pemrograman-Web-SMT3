{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/jobsheet-13/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.php"
    }
  ]
}
